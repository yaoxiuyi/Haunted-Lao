# ============================================================
# Haunted Lao — Environment Variables Example
# Copy this file to .env and fill in your values.
# .env is git-ignored and must never be committed.
# ============================================================

# --- Frontend build (optional) ---
# Base URL for GitHub Pages sub-path deployment.
# Leave empty for local development (defaults to '/').
# Example for GitHub Pages: VITE_BASE_URL=/haunted-lao/
VITE_BASE_URL=

# --- Audio generation script only (scripts/generate-audio.ts) ---
# These variables are used ONLY at build-prep time by the offline TTS script.
# They must NOT use the VITE_ prefix and will never be bundled into the frontend.
AZURE_TTS_KEY=
AZURE_TTS_REGION=
